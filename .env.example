# ============================================================================
# Configuration du SOC ERP Odoo
# ---------------------------------------------------------------------------

# ============================================================================
# 1. WAZUH - SIEM (manager + indexer + dashboard)
# ============================================================================
# Mot de passe du compte admin de l'indexer Wazuh (16 caractères minimum recommandé)
INDEXER_PASSWORD=put_your_strong_indexer_password_here

# Mot de passe de l'utilisateur API wazuh-wui (utilisé par le dashboard)
WAZUH_API_PASSWORD=put_your_wazuh_api_password_here

# Nom du détecteur d'anomalies OpenSearch (doit correspondre au script Python)
DETECTOR_ID=odoo-ssh-attack-detector


# ============================================================================
# 2. OPENSEARCH / WAZUH INDEXER - Accès API
# ============================================================================
# URL de l'indexer (laisser tel quel dans le réseau Docker interne)
ES_URL=https://wazuh.indexer:9200

# Utilisateur admin de l'indexer
ES_USER=admin

# Mot de passe de l'indexer (doit être identique à INDEXER_PASSWORD)
ES_PASS=put_your_strong_indexer_password_here


# ============================================================================
# 3. SHUFFLE - SOAR (orchestration)
# ============================================================================
# Mot de passe du compte administrateur de Shuffle
SHUFFLE_PASSWORD=put_your_shuffle_admin_password_here

# Clé API générée dans l'interface Shuffle (Settings -> API Keys)
SHUFFLE_APIKEY=put_your_shuffle_api_key_here


# ============================================================================
# 4. MISP - Threat Intelligence
# ============================================================================
# URL complète de votre instance MISP (externe ou interne)
MISP_URL=https://your-misp-instance.local

# Clé API MISP (générée dans Administration -> Auth Keys)
MISP_API_KEY=put_your_misp_api_key_here

# Mot de passe de la base de données MISP (utilisateur applicatif)
MISP_DB_PASSWORD=put_your_misp_db_password_here

# Mot de passe root de la base de données MISP
MISP_DB_ROOT_PASSWORD=put_your_misp_db_root_password_here

# Email de l'administrateur MISP (utilisé pour le premier login)
MISP_ADMIN_EMAIL=admin@example.local

# Passphrase de l'administrateur MISP (utilisée pour le premier login)
MISP_ADMIN_PASSPHRASE=put_your_misp_admin_passphrase_here


# ============================================================================
# 5. VIRUSTOTAL - Enrichissement de réputation
# ============================================================================
# Clé API VirusTotal (gratuite sur virustotal.com -> Profile -> API Key)
VIRUSTOTAL_API_KEY=put_your_virustotal_api_key_here


# ============================================================================
# 6. GROQ (LLM) - Génération de rapports
# ============================================================================
# Clé API Groq (gratuite sur console.groq.com -> API Keys)
GROQ_API_KEY=put_your_groq_api_key_here

# Modèle LLM à utiliser (laisser tel quel par défaut)
GROQ_MODEL=llama-3.3-70b-versatile


# ============================================================================
# 7. SMTP - Envoi des rapports par email
# ============================================================================
# Serveur SMTP (Gmail par défaut)
SMTP_HOST=smtp.gmail.com

# Port SMTP (587 pour TLS)
SMTP_PORT=587

# Adresse email expéditrice
SMTP_USER=put_your_smtp_email_here

# Mot de passe d'application (PAS le mot de passe principal Gmail)
SMTP_PASS=put_your_smtp_app_password_here

# Adresse email destinataire des rapports SOC
EMAIL_TO=put_your_recipient_email_here


# ============================================================================
# 8. Organisation (affiché en en-tête des rapports)
# ============================================================================
ORG_NAME=SOC Lab - ERP Odoo


# ============================================================================
# 9. AZURE - Utilisé par Shuffle pour le blocage des IP (NSG)
# ============================================================================
# ID de la souscription Azure
AZURE_SUB_ID=put_your_azure_subscription_id_here

# Nom du Resource Group contenant le NSG
AZURE_RG=rg-soc-lab

# ID du tenant Azure AD
AZURE_TENANT_ID=put_your_azure_tenant_id_here

# ID du client (Service Principal utilisé par Shuffle)
AZURE_CLIENT_ID=put_your_azure_client_id_here

# Secret du client (Service Principal)
AZURE_CLIENT_SECRET=put_your_azure_client_secret_here